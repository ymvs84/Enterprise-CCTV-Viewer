# --- CONFIGURACIÓN DE SEGURIDAD ---
# Genera una clave segura para producción
DJANGO_SECRET_KEY=cambiar_por_una_clave_secreta_y_larga

# True para desarrollo, False para producción
DEBUG=True

# Hosts permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- BASE DE DATOS ---
# sqlite (por defecto, para usar en el propio equipo)
# mssql (opcional, para usar SQL Server)
DB_ENGINE=sqlite

# Solo necesarias cuando DB_ENGINE=mssql
DB_NAME=Nombre_Base_Datos
DB_SERVER=IP_Servidor_o_Instancia

# Nota: Asegúrate de tener instalado el ODBC Driver 17 for SQL Server